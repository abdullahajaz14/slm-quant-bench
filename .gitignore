# slm-quant-bench
__pycache__/
*.pyc
.venv/
# Anchored with a leading slash: an unanchored "models/" also matches
# configs/models/, which silently excluded the model configuration files
# from the repository and made runs fail on any other machine.
/weights/
/models/
*.gguf
.DS_Store

# build artefacts
# Regenerated by scripts/figures.py; anchored for the same reason as
# /models/ above, so a docs/figures/ would still be tracked.
/figures/
.pytest_cache/
*.egg-info/
